# ─────────────────────────────────────────────────────────────────────────────
# LMS backend environment. Copy to `.env` and adjust as needed.
# The defaults match docker-compose.yml, so `npm run infra:up` + these values
# work out of the box for local development.
#
# Vars marked REQUIRED are validated on boot — the app refuses to start if they
# are missing or malformed (see src/config/env.validation.ts).
# ─────────────────────────────────────────────────────────────────────────────

# Runtime environment: development | production | test
NODE_ENV=development

# Port the HTTP server listens on. 5010, not 5000: macOS binds 5000 for the
# AirPlay Receiver, so the server would intermittently fail to start.
PORT=5010

# Global route prefix ("api" or "/api" both work). The Next.js frontend proxies
# /api/* here same-origin, so the refresh cookie path (/api/auth) matches what the
# browser sees.
API_PREFIX=api

# CORS allow-list: comma-separated exact origins, e.g.
#   http://localhost:3000,http://localhost:3001
#
# "*" is supported for local development and means "reflect the caller's
# origin". It does NOT send a literal `Access-Control-Allow-Origin: *` — the
# fetch spec forbids that alongside credentials, and this API authenticates with
# an httpOnly cookie, so a literal wildcard would break login in every browser.
# Reflection allows any origin to make CREDENTIALED requests, so it is refused
# in production: list exact origins there.
#   3000 = Next.js app (public site + admin panel)
CORS_ORIGINS=http://localhost:3000

# Public site URL. Used for links in emails.
FRONTEND_URL=http://localhost:3000

# --- Database (Postgres) ---
# REQUIRED. Matches the docker-compose postgres service.
# On AWS, point this at RDS and set DATABASE_SSL=true.
DATABASE_URL=postgresql://lms:lms_password@localhost:5434/lms
DATABASE_SSL=false

# --- Redis ---
# REQUIRED. Backs the rate limiter so limits hold across multiple instances.
# On AWS, point this at ElastiCache (rediss:// for TLS).
REDIS_URL=redis://localhost:6381

# --- Auth ---
# REQUIRED. Long random string (>=32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MIN=60
EMAIL_VERIFY_TTL_HOURS=24
BCRYPT_SALT_ROUNDS=12
# Block login until the email address is confirmed.
REQUIRE_EMAIL_VERIFIED=true

# --- Cookies ---
# The refresh token lives in an httpOnly cookie; it is never readable by JS.
# COOKIE_SECURE must be true in production (HTTPS only).
COOKIE_SECURE=false
# lax | strict | none. Use "none" ONLY if the frontend is on a different site
# than the API — it then also requires COOKIE_SECURE=true.
COOKIE_SAMESITE=lax
# Leave empty for host-only cookies. In production set the shared parent domain
# (e.g. .yourdomain.com) so app + api can share them.
COOKIE_DOMAIN=

# --- Mail (SMTP) ---
# Defaults target the mailpit container: everything is captured, nothing is
# actually delivered. Inbox UI: http://localhost:8027
# On AWS, swap in SES SMTP credentials.
SMTP_HOST=localhost
SMTP_PORT=1027
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TESOL TEFL Council <no-reply@lms.local>

# --- Storage (S3-compatible) ---
# "minio" for local, "s3" for AWS. Both use the same S3 API client, so moving
# to AWS means setting STORAGE_DRIVER=s3 + the AWS_* vars below. No code change.
STORAGE_DRIVER=minio
STORAGE_BUCKET=lms
# Private bucket for paid course materials (PDF/Word/PowerPoint). No public
# policy: files are only reachable through ~10 min signed URLs. Must differ from
# STORAGE_BUCKET. Created automatically on boot for MinIO; on AWS create it with
# Block Public Access on.
STORAGE_PRIVATE_BUCKET=lms-private
# Max upload size in bytes (default 10 MB).
UPLOAD_MAX_BYTES=10485760

# MinIO (used when STORAGE_DRIVER=minio) — matches docker-compose.
# Console UI: http://localhost:9005 (minioadmin / minioadmin)
MINIO_ENDPOINT=http://localhost:9004
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# Public base URL used to build object URLs.
MINIO_PUBLIC_URL=http://localhost:9004

# AWS S3 (used when STORAGE_DRIVER=s3). Prefer an IAM role on the instance and
# leave the key/secret empty — the SDK picks the role up automatically.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional CDN/CloudFront base URL for public object links.
S3_PUBLIC_URL=

# --- Admin seed ---
# `npm run seed:admin` creates this ADMIN if it does not already exist.
ADMIN_EMAIL=admin@ttc.com
ADMIN_PASSWORD=Password@123
ADMIN_NAME=Super Admin

# --- Rate limiting ---
# Global per-IP ceiling. Keep ~100 in production; raise only for local testing.
# The per-route auth caps (login 5/min, register 5/min, forgot 3/min) are
# declared in code and are NOT affected by this.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
